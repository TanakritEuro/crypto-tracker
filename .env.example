# Copy to .env.local and fill in. Restart the dev server after changing.

# -----------------------------------------------------------------------------
# Supabase — required for accounts, portfolio and watchlist.
# Market prices and charts work without these.
#
# Dashboard -> your project -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# CoinGecko — optional.
#
# Without a key the public API works but throttles at roughly 5-15 calls/minute,
# which is usually fine for one person because responses are cached server-side.
# A free demo key raises that ceiling: https://www.coingecko.com/en/api/pricing
# -----------------------------------------------------------------------------
COINGECKO_API_KEY=

# "demo" (default) or "pro" — selects the API host and the auth header.
COINGECKO_API_TIER=demo
